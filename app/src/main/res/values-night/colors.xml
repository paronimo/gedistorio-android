    <color name="fondo_secundario">#FF071A2B</color>
    <color name="superficie">#FF121212</color>
    <color name="superficie_suave">#FF1B1B1B</color>
    <color name="borde">#FF243B4D</color>

    <!-- Texto -->
    <color name="texto">#FFECF6FF</color>
    <color name="texto_secundario">#FFB6D4E8</color>
    <color name="texto_terciario">#FF8AA6B8</color>
    <color name="texto_sobre_primario">#FF00131F</color>
