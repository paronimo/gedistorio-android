<?xml version="1.0" encoding="utf-8"?>
<!--
    Estructura de navegacion. Solo "Historial" sigue sin logica real.
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.geditorio.ui.home.HomeFragment"
        android:label="@string/nav_inicio"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/misSalidasFragment"
        android:name="com.example.geditorio.ui.misSalidas.MisSalidasFragment"
        android:label="@string/nav_mis_salidas"
        tools:layout="@layout/fragment_mis_salidas">

        <action
            android:id="@+id/action_misSalidasFragment_to_detalleSalidaFragment"
            app:destination="@id/detalleSalidaFragment" />
    </fragment>

    <fragment
        android:id="@+id/detalleSalidaFragment"
        android:name="com.example.geditorio.ui.detalle.DetalleSalidaFragment"
        android:label="@string/titulo_detalle_salida"
        tools:layout="@layout/fragment_detalle_salida">

        <!-- Solo se pasa el id: el detalle busca la salida al abrirse. -->
        <argument
            android:name="salidaId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/reportarFragment"
        android:name="com.example.geditorio.ui.reportar.ReportarFragment"
        android:label="@string/nav_reportar"
        tools:layout="@layout/fragment_reportar" />

    <fragment
        android:id="@+id/historialFragment"
        android:name="com.example.geditorio.ui.historial.HistorialFragment"
        android:label="@string/nav_historial" />

</navigation>
